{
  "manifest_version": 3,
  "name": "NetScope Monitor",
  "version": "1.0.0",
  "description": "Capture browser network traffic and send it to the NetScope desktop app.",
  "permissions": [
    "webRequest",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NetScope Monitor"
  }
}
