# Copy this file to .env (already gitignored) and fill in the keys you want.
# After editing .env, fully restart `tauri dev` / the built app — it's only read at startup.

# Required for the "Scan for Malware" button in the file detail panel.
# Get a free API key at https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Optional — adds a second, independent malware-sample source alongside VirusTotal
# in the same "Scan for Malware" check. Get a free key at https://auth.abuse.ch/
MALWAREBAZAAR_API_KEY=

# Optional — raises the NVD CVE lookup rate limit used by "Search CVEs" in the
# service inspector from 5 to 50 requests/30s. Works without a key at the lower limit.
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
